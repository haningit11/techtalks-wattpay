
# Pooled Neon connection — used by the application
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_DEV_POOLER_HOST/neondb?sslmode=require"

# Direct Neon connection — used for migrations and seeding
DIRECT_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_DEV_DIRECT_HOST/neondb?sslmode=require"

# Only required when intentionally running the seed script.
# Use the existing development demo password.
SEED_DEMO_PASSWORD=""
