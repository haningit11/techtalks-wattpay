generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================================
// ENUMERATIONS
// ================================================

enum UserRole {
  OPERATOR
  METER_READER
  PAYMENT_COLLECTOR
  SUBSCRIBER
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  ENDED
}

enum ReadingStatus {
  BASELINE
  ACCEPTED
  FLAGGED
  RESOLVED
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// ================================================
// 1. USER
// ================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @db.VarChar(150)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamp(6)

  subscriberProfile Subscriber? @relation("SubscriberLogin")

  routeAssignments UserRouteAssignment[]

  submittedReadings MeterReading[] @relation("ReadingSubmittedBy")
  reviewedReadings  MeterReading[] @relation("ReadingReviewedBy")

  createdTariffs   Tariff[]
  generatedBills   Bill[]
  recordedPayments Payment[]

  auditLogs AuditLog[]
}

// ================================================
// 2. BUILDING
// ================================================

model Building {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  address     String   @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamp(6)

  subscribers Subscriber[]
}

// ================================================
// 3. COLLECTION ROUTE
// ================================================

model CollectionRoute {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(150)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamp(6)

  subscribers Subscriber[]

  userAssignments UserRouteAssignment[]
}

// ================================================
// 4. USER ROUTE ASSIGNMENT
// Junction table: User <-> CollectionRoute
// ================================================

model UserRouteAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  routeId    String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamp(6)
  isActive   Boolean  @default(true)

  user  User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  route CollectionRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)

  @@unique([userId, routeId])
  @@index([routeId])
}

// ================================================
// 5. SUBSCRIBER
// ================================================

model Subscriber {
  id          String @id @default(uuid()) @db.Uuid
  fullName    String @db.VarChar(150)
  phoneNumber String @db.VarChar(30)
  address     String @db.VarChar(255)

  buildingId String  @db.Uuid
  routeId    String  @db.Uuid
  userId     String? @unique @db.Uuid

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  building Building        @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  route    CollectionRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)
  user     User?           @relation("SubscriberLogin", fields: [userId], references: [id], onDelete: SetNull)

  subscriptions Subscription[]

  @@index([buildingId])
  @@index([routeId])
}

// ================================================
// 6. SUBSCRIPTION
// ================================================

model Subscription {
  id           String             @id @default(uuid()) @db.Uuid
  subscriberId String             @db.Uuid
  amperage     Decimal            @db.Decimal(6, 2)
  startDate    DateTime           @db.Date
  endDate      DateTime?          @db.Date
  status       SubscriptionStatus
  createdAt    DateTime           @default(now()) @db.Timestamp(6)
  updatedAt    DateTime           @default(now()) @updatedAt @db.Timestamp(6)

  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

  meterReadings MeterReading[]
  bills         Bill[]

  @@index([subscriberId, status])
}

// ================================================
// 7. METER READING
// ================================================

model MeterReading {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @db.Uuid
  billingMonth   DateTime @db.Date

  previousReadingValue Decimal? @db.Decimal(12, 3)
  submittedValue       Decimal  @db.Decimal(12, 3)
  approvedValue        Decimal? @db.Decimal(12, 3)
  consumptionKwh       Decimal? @db.Decimal(12, 3)

  status     ReadingStatus
  flagReason String?

  submittedByUserId String    @db.Uuid
  reviewedByUserId  String?   @db.Uuid
  reviewedAt        DateTime? @db.Timestamp(6)
  reviewNote        String?

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  submittedBy User  @relation("ReadingSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("ReadingReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  bill Bill?

  @@unique([subscriptionId, billingMonth])
  @@index([submittedByUserId])
  @@index([reviewedByUserId])
}

// ================================================
// 8. TARIFF
// ================================================

model Tariff {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  billingMonth DateTime @db.Date

  ratePerKwh Decimal  @db.Decimal(12, 4)
  fixedFee   Decimal  @db.Decimal(12, 2)
  currency   String   @db.VarChar(3)
  amperage   Decimal? @db.Decimal(6, 2)

  isActive Boolean @default(true)

  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamp(6)

  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  bills Bill[]

  @@unique([billingMonth, name])
  @@index([billingMonth, isActive])
}

// ================================================
// 9. BILL
// ================================================

model Bill {
  id String @id @default(uuid()) @db.Uuid

  subscriptionId String   @db.Uuid
  meterReadingId String   @unique @db.Uuid
  tariffId       String   @db.Uuid
  billingMonth   DateTime @db.Date

  // Historical billing snapshots
  amperageSnapshot        Decimal @db.Decimal(6, 2)
  previousReadingSnapshot Decimal @db.Decimal(12, 3)
  currentReadingSnapshot  Decimal @db.Decimal(12, 3)
  consumptionKwh          Decimal @db.Decimal(12, 3)

  ratePerKwh   Decimal @db.Decimal(12, 4)
  energyCharge Decimal @db.Decimal(12, 2)
  fixedFee     Decimal @db.Decimal(12, 2)
  totalAmount  Decimal @db.Decimal(12, 2)
  currency     String  @db.VarChar(3)

  status BillStatus

  generatedByUserId String   @db.Uuid
  generatedAt       DateTime @default(now()) @db.Timestamp(6)
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamp(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  meterReading MeterReading @relation(fields: [meterReadingId], references: [id], onDelete: Restrict)
  tariff       Tariff       @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  generatedBy  User         @relation(fields: [generatedByUserId], references: [id], onDelete: Restrict)

  payments Payment[]

  @@unique([subscriptionId, billingMonth])
  @@index([tariffId])
  @@index([generatedByUserId])
}

// ================================================
// 10. PAYMENT
// ================================================

model Payment {
  id     String @id @default(uuid()) @db.Uuid
  billId String @db.Uuid

  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @db.VarChar(3)
  paymentDate   DateTime @db.Timestamp(6)
  receiptNumber String   @unique @db.VarChar(50)

  recordedByUserId String  @db.Uuid
  notes            String?

  createdAt DateTime @default(now()) @db.Timestamp(6)

  bill       Bill @relation(fields: [billId], references: [id], onDelete: Restrict)
  recordedBy User @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@index([recordedByUserId])
}

// ================================================
// 11. AUDIT LOG
// ================================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String   @db.Uuid
  oldValue    Json?    @db.JsonB
  newValue    Json?    @db.JsonB
  description String?
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
